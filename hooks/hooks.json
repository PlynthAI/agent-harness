{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Context was just compacted. Skill and reference text loaded earlier may be gone or cut short, and the summary is not the instructions. Before the next step, re-open the skill and references the work in progress uses. Then re-read .state/state.md at the root of this checkout, if it exists, and the plan if the task has one, and continue from the recorded next action.\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?:Edit|Write|apply_patch|mcp__drawing_tools__(?:get_render|check|snapshot))$",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CODEX_HOME:-$HOME/.codex}/skills/design/drawing/scripts/post-drawing.mjs\" ] || node \"${CODEX_HOME:-$HOME/.codex}/skills/design/drawing/scripts/post-drawing.mjs\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -OutputFormat Text -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
