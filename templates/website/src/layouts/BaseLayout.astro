---
import "@/styles/global.css"
import { site } from "@/site"

type Props = {
  title?: string
  description?: string
  type?: "website" | "article"
  published?: Date
  noindex?: boolean
}

const {
  title,
  description = site.description,
  type = "website",
  published,
  noindex = false,
} = Astro.props
const pageTitle = title ? `${title} · ${site.name}` : site.name
const canonical = new URL(Astro.url.pathname, Astro.site).href
const path = Astro.url.pathname
const nav = [
  { href: "/articles/", label: "Articles" },
  { href: "/contact/", label: "Contact" },
]

// Follow the operating system's colour scheme unless <html data-theme="..."> is set explicitly.
// Runs inline before first paint so dark mode never flashes light; the design's tokens switch on
// data-theme="dark". The page loads no script file for it.
const themeScript = `(() => {
  const root = document.documentElement;
  if (root.dataset.theme) return;
  const query = window.matchMedia("(prefers-color-scheme: dark)");
  const apply = () => { root.dataset.theme = query.matches ? "dark" : "light"; };
  apply();
  query.addEventListener("change", apply);
})();`
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeScript} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="flex min-h-svh flex-col">
    <a
      href="#main"
      class="sr-only rounded-control bg-surface px-3 py-2 no-underline focus-visible:not-sr-only focus-visible:fixed focus-visible:top-3 focus-visible:left-3 focus-visible:z-10 focus-visible:bg-focus-fill"
    >
      Skip to content
    </a>
    <header class="border-b border-line">
      <div class="page-frame flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-4">
        <a href="/" class="t-title text-ink no-underline">
          {site.name}
        </a>
        <nav aria-label="Main">
          <ul class="flex gap-1">
            {nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={path.startsWith(item.href) ? "page" : undefined}
                  class="t-label-md block rounded-control px-3 py-2 text-ink-2 no-underline hover:bg-surface-2 hover:text-ink focus-visible:bg-focus-fill aria-[current=page]:text-ink"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1" class="flex-1 outline-hidden">
      <slot />
    </main>
    <footer class="border-t border-line">
      <div class="page-frame grid gap-6 py-12 md:grid-cols-12">
        <div class="flex flex-col gap-2 md:col-span-6">
          <p class="t-title text-ink">{site.name}</p>
          <p class="t-body-sm max-w-(--measure) text-ink-2">{site.description}</p>
        </div>
        <nav aria-label="Footer" class="md:col-span-6 md:justify-self-end">
          <ul class="t-body-sm flex flex-wrap gap-x-6 gap-y-2 text-ink-2">
            <li>
              <a href="/articles/">Articles</a>
            </li>
            <li>
              <a href="/contact/">Contact</a>
            </li>
            <li>
              <a href="/sitemap-index.xml">Sitemap</a>
            </li>
          </ul>
        </nav>
        <p class="t-caption md:col-span-12">
          Static pages built with Astro. The contact form is the only script this site loads.
        </p>
      </div>
    </footer>
  </body>
</html>
