---
import { ContactForm } from "@/components/ContactForm"
import BaseLayout from "@/layouts/BaseLayout.astro"
---

<BaseLayout
  title="Contact"
  description="Send a message through the site's contact form. This demo checks the message in your browser and sends nothing."
>
  <section class="page-frame grid gap-10 pt-12 pb-20 md:pt-16 lg:grid-cols-12 lg:gap-6">
    <header class="flex flex-col gap-4 lg:col-span-12">
      <h1 class="t-display-md font-heading md:t-size-display-lg text-ink">Contact</h1>
      <p class="t-body-lg max-w-(--measure) text-ink-2">
        Ask a question or tell us what is missing. Every field is required.
      </p>
    </header>
    <div class="lg:col-span-7">
      <noscript>
        <p class="t-body-md mb-6 rounded-control bg-surface-2 p-4 text-ink">
          The form needs JavaScript to check and send your message. Turn it on and reload the page.
        </p>
      </noscript>
      <ContactForm client:load />
    </div>
    <aside class="flex flex-col gap-2 lg:col-span-4 lg:col-start-9" aria-labelledby="handler-title">
      <h2 id="handler-title" class="t-title text-ink">
        Where your message goes
      </h2>
      <p class="t-body-md text-ink-2">
        Nowhere yet. This site has no server, so the form posts to a mocked handler in your browser:
        it checks what you wrote and shows the reply a real handler would give. Nothing leaves the
        page.
      </p>
    </aside>
  </section>
</BaseLayout>
