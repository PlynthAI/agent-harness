    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:up": "node scripts/dev.mjs up",
    "dev:status": "node scripts/dev.mjs status",
    "dev:stop": "node scripts/dev.mjs stop",
    "build": "astro build",
    "start": "astro preview",
    "lint": "astro sync && eslint .",
    "typecheck": "astro check",
