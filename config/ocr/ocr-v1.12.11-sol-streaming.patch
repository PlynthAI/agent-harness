+				writeResponsesSSE(w,
+					`{"type":"response.output_item.done","output_index":0,"item":{"id":"msg_diagnostic","type":"message","role":"assistant","status":"incomplete","content":[{"type":"output_text","text":"partial output"}]}}`,
+					fmt.Sprintf(`{"type":"response.%s","response":{"id":"resp_diagnostic","object":"response","model":"gpt-6.1","status":%q,"output":[],"error":{"code":"server_error","message":"provider diagnostic"},"incomplete_details":{"reason":"max_output_tokens"},"usage":{"input_tokens":12,"output_tokens":2048,"total_tokens":2060}}}`, status, status),
+				)
+			}))
+			defer server.Close()
+			collector := NewRetryCollector()
+			meta := testMeta()
+			client := NewOpenAIResponsesClient(ClientConfig{
+				URL: server.URL, Model: "gpt-6.1", ExtraBody: map[string]any{"stream": true}, retryCollector: collector,
+			})
+			resp, err := client.CompletionsWithCtx(metaCtx(meta), ChatRequest{Messages: []Message{{Role: "user", Content: "ping"}}})
+			if status == "failed" {
+				if resp != nil || err == nil || !strings.Contains(err.Error(), "status=failed") || !strings.Contains(err.Error(), "server_error") || !strings.Contains(err.Error(), "provider diagnostic") {
+					t.Fatalf("failed response/error = %v / %v, want provider terminal diagnostics", resp, err)
+				}
+				attempts := attemptsFor(t, collector, meta)
+				if len(attempts) != 1 || attempts[0].Outcome != AttemptError || attempts[0].ErrorClass != ErrorClassProvider || attempts[0].FailurePhase != FailurePhaseResponseStatus {
+					t.Errorf("failed response attempts = %+v", attempts)
