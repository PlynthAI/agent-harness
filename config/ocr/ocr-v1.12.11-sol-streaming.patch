+			}))
+			defer server.Close()
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			client := NewOpenAIResponsesClient(ClientConfig{
+				URL: server.URL, Model: "gpt-6.1", ExtraBody: map[string]any{"stream": true},
+			})
+			type result struct {
+				resp *ChatResponse
+				err  error
+			}
+			finished := make(chan result, 1)
+			go func() {
+				resp, err := client.CompletionsWithCtx(ctx, ChatRequest{Messages: []Message{{Role: "user", Content: "ping"}}})
+				finished <- result{resp, err}
+			}()
+			select {
+			case <-terminalSent:
+			case <-time.After(5 * time.Second):
+				t.Fatal("terminal event did not arrive")
+			}
+			select {
+			case got := <-finished:
+				if status == "failed" {
+					if got.resp != nil || got.err == nil || !strings.Contains(got.err.Error(), "terminal failure") {
+						t.Fatalf("failed terminal result = %v / %v", got.resp, got.err)
+					}
+				} else if got.err != nil || got.resp == nil || got.resp.Content() != "terminal output" {
+					t.Fatalf("terminal result = %v / %v", got.resp, got.err)
+				}
+			case <-time.After(2 * time.Second):
+				t.Fatal("client waited for EOF after terminal event")
+			}
+			select {
+			case <-connectionClosed:
+			case <-time.After(2 * time.Second):
+				t.Fatal("client left terminal stream connection open")
+			}
+		})
+	}
+}
+
+func writeResponsesSSE(w http.ResponseWriter, events ...string) {
+	w.Header().Set("Content-Type", "text/event-stream")
+	for _, event := range events {
+		_, _ = fmt.Fprintf(w, "data: %s\n\n", event)
 	}
 }
 
