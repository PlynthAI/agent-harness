+func (c *OpenAIResponsesClient) responsesStreaming(ctx context.Context, params responses.ResponseNewParams, opts ...openaiopt.RequestOption) (sdkResp *responses.Response, err error) {
+	defer func() {
+		if err != nil {
+			class, phase := classifyStreamError(err)
+			reviseAttempt(ctx, c.cfg.retryCollector, class, phase)
+		}
+	}()
+	stream := c.sdk.Responses.NewStreaming(ctx, params, opts...)
+	defer stream.Close()
+
+	var result responses.Response
+	var terminal bool
+	items := make(map[int64]responses.ResponseOutputItemUnion)
+streamEvents:
+	for stream.Next() {
+		event := stream.Current()
+		switch event.Type {
+		case "error":
+			return nil, &ssestream.StreamError{
+				Message: fmt.Sprintf("openai-responses stream error: code=%s message=%s", event.Code, event.Message),
+				Event:   ssestream.Event{Type: event.Type, Data: []byte(event.RawJSON())},
+			}
+		case "response.output_item.done":
+			items[event.OutputIndex] = event.Item
+		case "response.completed", "response.failed", "response.incomplete":
+			result = event.Response
+			terminal = true
+			break streamEvents
+		}
+	}
+	if err := stream.Err(); err != nil {
+		return nil, err
+	}
+	if !terminal {
+		return nil, &streamIntegrityError{reason: "ended before a terminal Responses event"}
+	}
+	// Some providers put replayable items only in output_item.done events.
+	// Keep those SDK values intact so ToParam can reuse their original JSON.
+	if len(result.Output) == 0 && len(items) > 0 {
+		indices := make([]int64, 0, len(items))
+		for index := range items {
+			indices = append(indices, index)
+		}
+		slices.Sort(indices)
+		for _, index := range indices {
+			result.Output = append(result.Output, items[index])
+		}
+	}
+	return &result, nil
+}
