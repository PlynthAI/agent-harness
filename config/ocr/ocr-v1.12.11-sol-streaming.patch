+func TestOpenAIResponsesClient_StreamingRequiresTerminal(t *testing.T) {
+	for _, doneMarker := range []bool{false, true} {
+		t.Run(fmt.Sprintf("done_marker_%t", doneMarker), func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				writeResponsesSSE(w,
+					`{"type":"response.created","response":{"id":"resp_cutoff","status":"in_progress","output":[]}}`,
+					`{"type":"response.output_item.done","output_index":0,"item":{"id":"msg_cutoff","type":"message","role":"assistant","status":"completed","content":[{"type":"output_text","text":"partial output"}]}}`,
+				)
+				if doneMarker {
+					_, _ = io.WriteString(w, "data: [DONE]\n\n")
+				}
+			}))
+			defer server.Close()
+			collector := NewRetryCollector()
+			meta := testMeta()
+			client := NewOpenAIResponsesClient(ClientConfig{
+				URL: server.URL, Model: "gpt-6.1", ExtraBody: map[string]any{"stream": true}, retryCollector: collector,
+			})
+			resp, err := client.CompletionsWithCtx(metaCtx(meta), ChatRequest{Messages: []Message{{Role: "user", Content: "ping"}}})
+			var integrityErr *streamIntegrityError
+			if resp != nil || !errors.As(err, &integrityErr) {
+				t.Fatalf("response/error = %v / %v, want nil response and incomplete-stream error", resp, err)
+			}
+			attempts := attemptsFor(t, collector, meta)
+			if len(attempts) != 1 || attempts[0].Outcome != AttemptError || attempts[0].StatusCode != http.StatusOK || attempts[0].ErrorClass != ErrorClassProvider || attempts[0].FailurePhase != FailurePhaseStream {
+				t.Errorf("incomplete stream attempts = %+v", attempts)
+			}
+			if request := freezeOne(t, collector); request.Outcome != OutcomeFailed {
+				t.Errorf("incomplete stream request outcome = %s", request.Outcome)
+			}
+		})
+	}
+}
