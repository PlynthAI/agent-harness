+func TestOpenAIResponsesClient_StreamingMidStreamErrors(t *testing.T) {
+	cases := []struct {
+		name, event, message string
+		class                ErrorClass
+	}{
+		{"typed provider error", `{"type":"error","code":"server_error","message":"stream provider diagnostic"}`, "stream provider diagnostic", ErrorClassProvider},
+		{"wrapped provider error", `{"error":{"code":"server_error","message":"wrapped provider diagnostic"}}`, "wrapped provider diagnostic", ErrorClassProvider},
+		{"malformed event", `{"type":`, "", ErrorClassUnknown},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				writeResponsesSSE(w,
+					`{"type":"response.output_item.done","output_index":0,"item":{"id":"msg_error","type":"message","role":"assistant","content":[{"type":"output_text","text":"discard this output"}]}}`,
+					tc.event,
+				)
+			}))
+			defer server.Close()
+			collector := NewRetryCollector()
+			meta := testMeta()
+			client := NewOpenAIResponsesClient(ClientConfig{
+				URL: server.URL, Model: "gpt-6.1", ExtraBody: map[string]any{"stream": true}, retryCollector: collector,
+			})
+			resp, err := client.CompletionsWithCtx(metaCtx(meta), ChatRequest{Messages: []Message{{Role: "user", Content: "ping"}}})
+			if resp != nil || err == nil {
+				t.Fatalf("response/error = %v / %v, want nil response and stream error", resp, err)
+			}
+			if tc.message != "" {
+				var streamErr *ssestream.StreamError
+				if !errors.As(err, &streamErr) || !strings.Contains(err.Error(), tc.message) {
+					t.Errorf("provider stream error = %T / %v", err, err)
+				}
+			} else {
+				var syntaxErr *json.SyntaxError
+				if !errors.As(err, &syntaxErr) {
+					t.Errorf("malformed event error = %T / %v", err, err)
+				}
+			}
+			attempts := attemptsFor(t, collector, meta)
+			if len(attempts) != 1 || attempts[0].Outcome != AttemptError || attempts[0].ErrorClass != tc.class || attempts[0].FailurePhase != FailurePhaseStream {
+				t.Errorf("stream error attempts = %+v", attempts)
+			}
+			if request := freezeOne(t, collector); request.Outcome != OutcomeFailed {
+				t.Errorf("stream error request outcome = %s", request.Outcome)
+			}
+		})
+	}
+}
 
