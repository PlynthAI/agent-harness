+const fs = require("fs");
+const path = require("path");
+const vm = require("vm");
+const { EventEmitter } = require("events");
+
+async function runUpdater(installedVersion, latestVersion) {
+  const hintPath = path.join("/fixture-home", ".opencodereview", "update-available");
+  const lockPath = path.join("/fixture-home", ".opencodereview", "update.lock");
+  const files = new Map([[hintPath, "stale update hint"]]);
+  const installs = [];
+  const fetches = [];
+  const mocks = {
+    fs: {
+      mkdirSync() {},
+      utimesSync() {},
+      readFileSync(file) { return files.get(file); },
+      writeFileSync(file, value) { files.set(file, value); },
+      unlinkSync(file) { files.delete(file); },
+    },
+    path,
+    os: { homedir: () => "/fixture-home" },
+    https: {
+      get(url, options, callback) {
+        fetches.push(url);
+        const request = new EventEmitter();
+        request.destroy = () => {};
+        queueMicrotask(() => {
+          const response = new EventEmitter();
+          response.statusCode = 200;
+          response.resume = () => {};
+          callback(response);
+          response.emit("data", JSON.stringify({ version: latestVersion }));
+          response.emit("end");
+        });
+        return request;
+      },
+    },
+    child_process: {
+      spawnSync(command, args) {
+        if (command === "/fixture/ocr.exe") {
+          return { status: 0, stdout: `open-code-review v${installedVersion} (a758d9c) windows/amd64` };
+        }
+        installs.push([command, Array.from(args)]);
+        return { status: 0 };
+      },
+    },
+    "./platform": { resolveNativeBinary: () => ({ path: "/fixture/ocr.exe" }) },
+    "./install.js": { loadPackageJson: () => ({ name: "@alibaba-group/open-code-review" }) },
+    "./version": require("./version"),
+  };
+  vm.runInNewContext(fs.readFileSync(path.join(__dirname, "update.js"), "utf8"), {
+    require(name) {
+      assert.ok(Object.prototype.hasOwnProperty.call(mocks, name), `unexpected module: ${name}`);
+      return mocks[name];
+    },
+    process: { pid: 123, platform: process.platform },
+  }, { filename: "update.js" });
+  await new Promise(setImmediate);
+  assert.strictEqual(files.has(lockPath), false, "updater must release its lock");
+  return { installs, fetches, hasHint: files.has(hintPath) };
+}
+
+async function testUpdaterBuildProtection() {
+  for (const installedVersion of ["1.12.11", "1.12.11+vendor.1"]) {
+    const result = await runUpdater(installedVersion, "1.12.12");
+    assert.deepStrictEqual(result.installs, [["npm", ["i", "-g", "@alibaba-group/open-code-review@1.12.12"]]],
+      "ordinary builds must retain automatic npm updates");
+    assert.strictEqual(result.hasHint, false, "successful install must clear a stale hint");
+  }
+  const unchanged = await runUpdater("1.12.11", "1.12.11");
+  assert.deepStrictEqual(unchanged.installs, [], "current stock release must not reinstall itself");
+
+  const custom = await runUpdater("1.12.11+sol-streaming", "1.12.12");
+  assert.deepStrictEqual(custom.installs, [], "updater must preserve the local Sol streaming build");
+  assert.deepStrictEqual(custom.fetches, [], "protected local build must skip registry polling");
+  assert.strictEqual(custom.hasHint, false, "protected local build must clear an obsolete stock-update hint");
+  console.log("updater custom-build tests passed");
+}
